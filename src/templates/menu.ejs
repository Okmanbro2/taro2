<!-- welcome / play menu -->
<div id="play-game-button-wrapper" class="h-100 w-100 d-flex justify-content-center align-items-center position-absolute d-none-important">
	<div class="pvz-welcome-card">

		<div class="pvz-welcome-left">
			<div class="pvz-logo-block" aria-label="Plants vs. Zombies: Roam">
				<img src="/assets/images/favicon.png" alt="Plants vs. Zombies: Roam" class="pvz-logo-image">
			</div>

			<div class="pvz-changelog-panel">
				<h3 class="pvz-changelog-title">Changelog</h3>
				<div id="pvz-changelog-list" class="pvz-changelog-list">
					<!-- populated from /assets/data/changelog.json by the script below -->
				</div>
			</div>
		</div>

		<div class="pvz-welcome-right">
			<h1 class="pvz-welcome-heading">Welcome to Plants vs. Zombies: Roam 2!</h1>
			<div id="pvz-version-number" class="pvz-version-number"><!-- filled from changelog.json --></div>

			<p class="pvz-welcome-description">
				Plants vs. Zombies: Roam 2 puts you in the shoes of the plants. Defend your lawn against 50 flags
				of zombies and face Zomboss at the end! Want more action? Gamemodes and Mini-games allow for
				more fun! From classics like Vase breaker to Last Stand, to custom made modes like Brutal and
				Crazy, the game has lots to offer.
			</p>

			<p class="pvz-welcome-cta">What are you waiting for?!</p>

			<div class="pvz-button-row">
				<button id="play-game-button" type="button" class="pvz-play-button" data-style="rotate-side-down" data-perspective data-horizontal>
					PLAY NOW!!!
				</button>

				<div class="pvz-icon-button-group">
					<a href="javascript:void(0)" id="pvz-discord-button" class="pvz-icon-button" title="Discord server coming soon" aria-label="Discord server (coming soon)">
						<i class="fab fa-discord" aria-hidden="true"></i>
					</a>
				</div>
			</div>
		</div>

		<div class="pvz-welcome-footer">
			<a href="javascript:void(0)" id="pvz-leaderboard-button" class="pvz-icon-button pvz-footer-leaderboard-button" title="View leaderboard" aria-label="View leaderboard">
				<i class="fa fa-trophy" aria-hidden="true"></i>
			</a>
			<span id="pvz-footer-credit">2026 thw0kyple, footsoldier</span>
		</div>
	</div>
</div>

<script>
	(function () {
		fetch('/assets/data/changelog.json')
			.then(function (res) { return res.json(); })
			.then(function (data) {
				var versionEl = document.getElementById('pvz-version-number');
				if (versionEl && data.version) {
					versionEl.textContent = 'Version ' + data.version;
				}

				var listEl = document.getElementById('pvz-changelog-list');
				if (listEl && Array.isArray(data.entries)) {
					listEl.innerHTML = '';
					data.entries.forEach(function (entry) {
						var entryDiv = document.createElement('div');
						entryDiv.className = 'pvz-changelog-entry';

						var titleEl = document.createElement('h4');
						titleEl.className = 'pvz-changelog-entry-title';
						titleEl.textContent = entry.title || '';

						var descEl = document.createElement('p');
						descEl.className = 'pvz-changelog-entry-desc';
						descEl.textContent = entry.description || '';

						entryDiv.appendChild(titleEl);
						entryDiv.appendChild(descEl);
						listEl.appendChild(entryDiv);
					});
				}
			})
			.catch(function (err) {
				console.warn('Could not load changelog.json:', err);
			});

		// ---- menu music ----
		var menuMusic = new Audio('/assets/audio/MenuMusic.mp3');
		menuMusic.loop = true;
		menuMusic.volume = 1;
		var menuMusicStarted = false;

		function tryStartMenuMusic() {
			if (menuMusicStarted) {
				return;
			}
			menuMusic.play().then(function () {
				menuMusicStarted = true;
			}).catch(function (err) {
				console.log('Menu music waiting on user interaction to start:', err.message);
			});
		}

		window.addEventListener('taroGameReadyToPlay', tryStartMenuMusic);
		document.addEventListener('click', tryStartMenuMusic, { once: true });
		document.addEventListener('keydown', tryStartMenuMusic, { once: true });

		function fadeOutMenuMusic(durationMs) {
			var startVolume = menuMusic.volume;
			var startTime = performance.now();

			function step(now) {
				var elapsed = now - startTime;
				var pct = Math.min(elapsed / durationMs, 1);
				menuMusic.volume = startVolume * (1 - pct);
				if (pct < 1) {
					requestAnimationFrame(step);
				} else {
					menuMusic.pause();
					menuMusic.currentTime = 0;
				}
			}
			requestAnimationFrame(step);
		}

		var playButtonForMusic = document.getElementById('play-game-button');
		if (playButtonForMusic) {
			playButtonForMusic.addEventListener('click', function () {
				fadeOutMenuMusic(1500);
			});
		}
	})();
</script>
