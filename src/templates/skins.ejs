<style>
	#pvz-skins-backdrop {
		position: fixed;
		inset: 0;
		z-index: 100000;
		display: flex;
		justify-content: center;
		background: rgba(0, 0, 0, 0.45);
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.35s ease;
	}

	#pvz-skins-backdrop.pvz-skins-open {
		opacity: 1;
		pointer-events: auto;
	}

	#pvz-skins-panel {
		width: min(920px, 94vw);
		max-height: 82vh;
		margin-top: 40px;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		background: var(--pvz-grass);
		border: 6px solid #5b8f32;
		border-radius: 18px;
		box-shadow: 0 8px 0 #5b8f32, 0 20px 40px rgba(0, 0, 0, 0.4);
		padding: 20px 24px 24px;
		font-family: 'Brianne\'s Hand', cursive;
		transform: translateY(-140%);
		transition: transform 0.4s ease;
	}

	#pvz-skins-backdrop.pvz-skins-open #pvz-skins-panel {
		transform: translateY(0);
	}

	#pvz-skins-header {
		position: relative;
		text-align: center;
		margin-bottom: 4px;
	}

	#pvz-skins-title {
		font-family: 'Brianne\'s Hand', cursive;
		color: var(--pvz-cream);
		text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.4);
		font-size: 2em;
		margin: 0;
	}

	#pvz-skins-close {
		position: absolute;
		top: -4px;
		right: 0;
		width: 40px;
		height: 40px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--pvz-grass-dark);
		border: 3px solid #5b8f32;
		border-radius: 10px;
		color: #e53935;
		font-family: 'Brianne\'s Hand', cursive;
		font-size: 1.6em;
		line-height: 1;
		cursor: pointer;
		text-decoration: none;
	}

	#pvz-skins-gems-row {
		text-align: center;
		font-family: 'Brianne\'s Hand', cursive;
		color: #ffd54f;
		font-size: 1.15em;
		margin-bottom: 8px;
	}

	#pvz-skins-gems-row img {
		width: 18px;
		height: 18px;
		vertical-align: -2px;
		margin-right: 4px;
	}

	#pvz-skins-rule {
		border: none;
		border-top: 2px solid rgba(255, 255, 255, 0.4);
		margin: 8px 0 10px;
	}

	#pvz-skins-tabs {
		display: flex;
		gap: 6px;
		margin-bottom: 12px;
	}

	.pvz-skins-tab {
		flex: 1;
		font-family: 'Brianne\'s Hand', cursive;
		font-weight: 700;
		font-size: 0.95em;
		padding: 8px 10px;
		border: 3px solid #5b8f32;
		border-radius: 9px;
		background: var(--pvz-grass-dark);
		color: var(--pvz-cream);
		cursor: pointer;
		transition: background 0.15s ease, transform 0.15s ease, opacity 0.15s ease;
	}

	.pvz-skins-tab:hover:not(:disabled) {
		background: #4f822d;
		transform: translateY(-1px);
	}

	.pvz-skins-tab.active {
		background: #79a942;
		box-shadow: inset 0 -3px 0 rgba(0, 0, 0, 0.15);
	}

	.pvz-skins-tab:disabled {
		background: #666;
		border-color: #777;
		color: #aaa;
		cursor: not-allowed;
		opacity: 0.65;
	}

	#pvz-skins-body-row {
		display: flex;
		gap: 12px;
		flex: 1;
		min-height: 0;
	}

	#pvz-skins-sidebar {
		flex-shrink: 0;
		width: 140px;
		overflow-y: auto;
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding-right: 2px;
	}

	.pvz-skins-category-btn {
		font-family: 'Brianne\'s Hand', cursive;
		font-weight: 700;
		font-size: 0.85em;
		padding: 8px 10px;
		border: 3px solid #5b8f32;
		border-radius: 9px;
		background: var(--pvz-grass-dark);
		color: var(--pvz-cream);
		cursor: pointer;
		text-align: left;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		transition: background 0.15s ease, transform 0.15s ease;
	}

	.pvz-skins-category-btn:hover {
		background: #4f822d;
		transform: translateX(2px);
	}

	.pvz-skins-category-btn.active {
		background: #79a942;
		box-shadow: inset 0 -3px 0 rgba(0, 0, 0, 0.15);
	}

	#pvz-skins-list {
		overflow-y: auto;
		overflow-x: hidden;
		flex: 1;
		min-height: 0;
		padding-right: 4px;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.pvz-skin-card {
		position: relative;
		display: flex;
		gap: 14px;
		align-items: center;
		background: var(--pvz-grass-dark);
		border: 3px solid #5b8f32;
		border-radius: 10px;
		padding: 10px 14px;
	}

	.pvz-skin-card.pvz-skin-sale {
		border-color: #d39c32;
		box-shadow: inset 0 0 0 1px rgba(255, 213, 79, 0.25);
	}

	.pvz-skin-image {
		flex-shrink: 0;
		width: 64px;
		height: 64px;
		border-radius: 6px;
		background: transparent;
		object-fit: contain;
	}

	.pvz-skin-info {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
	}

	.pvz-skin-name {
		font-family: 'Brianne\'s Hand', cursive;
		color: var(--pvz-cream);
		text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.4);
		font-size: 1.15em;
		margin: 0 0 2px;
	}

	.pvz-skin-subtitle {
		font-family: 'Brianne\'s Hand', cursive;
		color: var(--pvz-cream);
		opacity: 0.85;
		font-size: 0.9em;
		margin: 0 0 6px;
		display: flex;
		align-items: center;
		gap: 6px;
		flex-wrap: wrap;
	}

	.pvz-skin-tag {
		display: inline-block;
		font-family: 'Brianne\'s Hand', cursive;
		font-size: 0.75em;
		font-weight: 700;
		padding: 1px 7px;
		border-radius: 999px;
	}

	.pvz-skin-tag-limited {
		background: #ff8f00;
		color: #fff;
	}

	.pvz-skin-tag-sale {
		background: #e53935;
		color: #fff;
	}

	.pvz-skin-tag-unavailable {
		background: #555;
		color: #ccc;
	}

	.pvz-skin-price-row {
		font-family: 'Brianne\'s Hand', cursive;
		font-size: 0.95em;
		display: flex;
		align-items: center;
		gap: 6px;
	}

	.pvz-skin-price-original {
		color: var(--pvz-cream);
		opacity: 0.6;
		text-decoration: line-through;
	}

	.pvz-skin-price-current {
		color: #ffd54f;
	}

	.pvz-skin-actions {
		flex-shrink: 0;
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 6px;
		min-width: 96px;
	}

	.pvz-skin-btn {
		font-family: 'Brianne\'s Hand', cursive;
		font-weight: 700;
		font-size: 0.85em;
		border-radius: 8px;
		border: none;
		padding: 6px 10px;
		cursor: pointer;
	}

	.pvz-skin-btn-buy {
		background: #ffca28;
		color: #4a3200;
	}

	.pvz-skin-btn-buy:disabled {
		background: #777;
		color: #ccc;
		cursor: not-allowed;
	}

	.pvz-skin-btn-equip {
		background: #66bb6a;
		color: #fff;
	}

	.pvz-skin-btn-unequip {
		background: #e53935;
		color: #fff;
	}

	.pvz-skin-equipped-label {
		text-align: center;
		font-family: 'Brianne\'s Hand', cursive;
		color: #a5d6a7;
		font-size: 0.85em;
	}

	.pvz-skins-empty,
	.pvz-skins-error {
		font-family: 'Brianne\'s Hand', cursive;
		color: var(--pvz-cream);
		opacity: 0.7;
		text-align: center;
		padding: 16px 0;
	}

	.pvz-skins-error {
		color: #ff8a80;
	}

	#pvz-skins-confirm-backdrop {
		position: fixed;
		inset: 0;
		z-index: 100010;
		display: none;
		align-items: center;
		justify-content: center;
		background: rgba(0, 0, 0, 0.5);
	}

	#pvz-skins-confirm-backdrop.pvz-skins-confirm-open {
		display: flex;
	}

	#pvz-skins-confirm-panel {
		width: min(470px, 88vw);
		padding: 20px;
		background: var(--pvz-grass);
		border: 5px solid #5b8f32;
		border-radius: 16px;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
		text-align: center;
	}

	#pvz-skins-confirm-title {
		font-family: 'Brianne\'s Hand', cursive;
		font-size: 1.55em;
		color: var(--pvz-cream);
		text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.35);
		margin: 0 0 10px;
	}

	#pvz-skins-confirm-text {
		font-family: 'Brianne\'s Hand', cursive;
		font-size: 1.05em;
		color: var(--pvz-cream);
		line-height: 1.35;
		margin-bottom: 18px;
	}

	#pvz-skins-confirm-buttons {
		display: flex;
		gap: 10px;
	}

	.pvz-skins-confirm-btn {
		flex: 1;
		font-family: 'Brianne\'s Hand', cursive;
		font-weight: 700;
		font-size: 0.95em;
		padding: 9px 12px;
		border: none;
		border-radius: 8px;
		cursor: pointer;
	}

	#pvz-skins-confirm-yes {
		background: #66bb6a;
		color: #fff;
	}

	#pvz-skins-confirm-no {
		background: #e53935;
		color: #fff;
	}

	.pvz-skins-confirm-btn:disabled {
		opacity: 0.6;
		cursor: not-allowed;
	}
</style>

<div id="pvz-skins-backdrop">
	<div id="pvz-skins-panel">
		<div id="pvz-skins-header">
			<h2 id="pvz-skins-title">Skins</h2>
			<a href="javascript:void(0)" id="pvz-skins-close" aria-label="Close skins">X</a>
		</div>
		<div id="pvz-skins-gems-row"><img src="/assets/images/gemcurrencyicon.png" alt="" /><span id="pvz-skins-gems-count">0</span> Gems</div>
		<hr id="pvz-skins-rule" />

		<div id="pvz-skins-tabs" role="tablist" aria-label="Skin categories">
			<button type="button" class="pvz-skins-tab active" data-tab="store">Store</button>
			<button type="button" class="pvz-skins-tab" data-tab="inventory">Inventory</button>
			<button type="button" class="pvz-skins-tab" data-tab="limited">Limited</button>
		</div>

		<div id="pvz-skins-body-row">
			<div id="pvz-skins-sidebar"></div>
			<div id="pvz-skins-list"></div>
		</div>
	</div>
</div>

<div id="pvz-skins-confirm-backdrop">
	<div id="pvz-skins-confirm-panel" role="dialog" aria-modal="true" aria-labelledby="pvz-skins-confirm-title">
		<h3 id="pvz-skins-confirm-title">Purchase skin?</h3>
		<div id="pvz-skins-confirm-text"></div>
		<div id="pvz-skins-confirm-buttons">
			<button type="button" class="pvz-skins-confirm-btn" id="pvz-skins-confirm-yes">Let's rock!</button>
			<button type="button" class="pvz-skins-confirm-btn" id="pvz-skins-confirm-no">Maybe later!</button>
		</div>
	</div>
</div>

<script>
	(function () {
		var $backdrop = document.getElementById('pvz-skins-backdrop');
		var $panel = document.getElementById('pvz-skins-panel');
		var $closeBtn = document.getElementById('pvz-skins-close');
		var $openBtn = document.getElementById('pvz-skins-button');
		var $list = document.getElementById('pvz-skins-list');
		var $gemsCount = document.getElementById('pvz-skins-gems-count');
		var $tabs = document.querySelectorAll('.pvz-skins-tab');
		var $sidebar = document.getElementById('pvz-skins-sidebar');
		var $confirmBackdrop = document.getElementById('pvz-skins-confirm-backdrop');
		var $confirmText = document.getElementById('pvz-skins-confirm-text');
		var $confirmYes = document.getElementById('pvz-skins-confirm-yes');
		var $confirmNo = document.getElementById('pvz-skins-confirm-no');

		var currentTab = 'store';
		var currentCategory = null; // null = "All" - a specific unitType id otherwise
		var cachedSkins = [];
		var cachedEquippedSkins = {};
		var pendingPurchase = null;

		function authedFetch(url, options) {
			return window.getFirebaseIdToken().then(function (idToken) {
				options = options || {};
				options.headers = Object.assign({
					'Content-Type': 'application/json',
					Authorization: 'Bearer ' + idToken
				}, options.headers || {});
				return fetch(url, options).then(function (res) {
					return res.json().then(function (json) {
						if (!res.ok) {
							throw new Error(json.error || 'request failed');
						}
						return json;
					});
				});
			});
		}

		function setCategory(unitType) {
			currentCategory = unitType;
			renderSidebar();
			renderCurrentTab();
		}

		// builds one button per unique unitType found in cachedSkins, labeled
		// with the unit's actual display name (unitTypeName) rather than its
		// raw id - "peashooter", not "CbHUJI1d2B" - skins sharing the same
		// unitType (e.g. the 3 Peashooter skins) collapse into a single
		// category button, since they're all the same unit underneath
		function renderSidebar() {
			$sidebar.innerHTML = '';

			var categoriesById = {};
			cachedSkins.forEach(function (skin) {
				if (!categoriesById[skin.unitType]) {
					categoriesById[skin.unitType] = skin.unitTypeName || skin.unitType;
				}
			});
			var categories = Object.keys(categoriesById).map(function (unitType) {
				return { unitType: unitType, name: categoriesById[unitType] };
			});
			categories.sort(function (a, b) {
				return a.name.localeCompare(b.name);
			});

			var $allBtn = document.createElement('button');
			$allBtn.type = 'button';
			$allBtn.className = 'pvz-skins-category-btn' + (currentCategory === null ? ' active' : '');
			$allBtn.textContent = 'All';
			$allBtn.addEventListener('click', function () {
				setCategory(null);
			});
			$sidebar.appendChild($allBtn);

			categories.forEach(function (category) {
				var $btn = document.createElement('button');
				$btn.type = 'button';
				$btn.className = 'pvz-skins-category-btn' + (currentCategory === category.unitType ? ' active' : '');
				$btn.textContent = category.name;
				$btn.title = category.name;
				$btn.addEventListener('click', function () {
					setCategory(category.unitType);
				});
				$sidebar.appendChild($btn);
			});
		}

		function updateLimitedTab() {
			var hasAvailableLimited = cachedSkins.some(function (skin) {
				return skin.availability === 'limited' && skin.purchasable;
			});

			$tabs.forEach(function ($tab) {
				if ($tab.dataset.tab === 'limited') {
					$tab.disabled = !hasAvailableLimited;
					if (!hasAvailableLimited) {
						$tab.title = 'There are no limited skins available right now.';
					} else {
						$tab.removeAttribute('title');
					}
				}
			});

			if (!hasAvailableLimited && currentTab === 'limited') {
				setTab('store');
			}
		}

		function setTab(tab) {
			currentTab = tab;
			$tabs.forEach(function ($tab) {
				$tab.classList.toggle('active', $tab.dataset.tab === tab);
			});
			renderCurrentTab();
		}

		function renderCurrentTab() {
			var skins = cachedSkins.slice();

			if (currentCategory !== null) {
				skins = skins.filter(function (skin) {
					return skin.unitType === currentCategory;
				});
			}

			if (currentTab === 'inventory') {
				skins = skins.filter(function (skin) {
					return !!skin.owned;
				});
			} else if (currentTab === 'limited') {
				skins = skins.filter(function (skin) {
					return skin.availability === 'limited' && skin.purchasable;
				});
			} else {
				// store contains the normal/permanent catalog, limited skins have
				// their own tab & active individual sales appear first
				skins = skins.filter(function (skin) {
					return skin.availability !== 'limited';
				});
				skins.sort(function (a, b) {
					return Number(!!b.onSale) - Number(!!a.onSale);
				});
			}

			renderSkins(skins, cachedEquippedSkins);
		}

		function renderSkins(skins, equippedSkins) {
			$list.innerHTML = '';

			if (!skins || skins.length === 0) {
				var $empty = document.createElement('div');
				$empty.className = 'pvz-skins-empty';
				$empty.textContent = currentTab === 'limited'
					? 'No limited skins are available right now.'
					: currentTab === 'inventory'
						? 'You do not own any skins yet.'
						: 'No skins yet - check back soon!';
				$list.appendChild($empty);
				return;
			}

			skins.forEach(function (skin) {
				var $card = document.createElement('div');
				$card.className = 'pvz-skin-card' + (skin.onSale ? ' pvz-skin-sale' : '');

				var $image = document.createElement('img');
				$image.className = 'pvz-skin-image';
				$image.src = skin.image || '/assets/images/favicon.png';
				$image.alt = skin.name || 'Skin';

				var $info = document.createElement('div');
				$info.className = 'pvz-skin-info';

				var $name = document.createElement('h3');
				$name.className = 'pvz-skin-name';
				$name.textContent = skin.name || 'Skin';

				var $subtitle = document.createElement('p');
				$subtitle.className = 'pvz-skin-subtitle';
				var subtitleText = document.createElement('span');
				var subtitleLabel = 'For ' + (skin.unitTypeName || 'Unknown');
				if (skin.description) {
					subtitleLabel += ' - ' + skin.description;
				}
				subtitleText.textContent = subtitleLabel;
				$subtitle.appendChild(subtitleText);

				if (skin.availability === 'limited') {
					var $limitedTag = document.createElement('span');
					$limitedTag.className = 'pvz-skin-tag ' + (skin.purchasable || skin.owned ? 'pvz-skin-tag-limited' : 'pvz-skin-tag-unavailable');
					$limitedTag.textContent = skin.purchasable || skin.owned ? 'Limited' : 'No longer available';
					$subtitle.appendChild($limitedTag);
				}

				if (skin.onSale) {
					var $saleTag = document.createElement('span');
					$saleTag.className = 'pvz-skin-tag pvz-skin-tag-sale';
					$saleTag.textContent = 'SALE';
					$subtitle.appendChild($saleTag);
				}

				var $priceRow = document.createElement('div');
				$priceRow.className = 'pvz-skin-price-row';
				if (!skin.owned) {
					if (skin.effectivePrice < skin.price) {
						var $original = document.createElement('span');
						$original.className = 'pvz-skin-price-original';
						$original.textContent = skin.price + ' Gems';
						$priceRow.appendChild($original);
					}
					var $current = document.createElement('span');
					$current.className = 'pvz-skin-price-current';
					$current.textContent = skin.effectivePrice + ' Gems';
					$priceRow.appendChild($current);
				}

				$info.appendChild($name);
				$info.appendChild($subtitle);
				$info.appendChild($priceRow);

				var $actions = document.createElement('div');
				$actions.className = 'pvz-skin-actions';

				var isEquipped = equippedSkins && equippedSkins[skin.unitType] === skin.id;

				if (!skin.owned) {
					var $buyBtn = document.createElement('button');
					$buyBtn.type = 'button';
					$buyBtn.className = 'pvz-skin-btn pvz-skin-btn-buy';
					$buyBtn.textContent = 'Buy';
					$buyBtn.disabled = !skin.purchasable;
					$buyBtn.addEventListener('click', function () {
						openPurchaseConfirmation(skin, $buyBtn);
					});
					$actions.appendChild($buyBtn);
				} else if (isEquipped) {
					var $equippedLabel = document.createElement('div');
					$equippedLabel.className = 'pvz-skin-equipped-label';
					$equippedLabel.textContent = 'Equipped';
					var $unequipBtn = document.createElement('button');
					$unequipBtn.type = 'button';
					$unequipBtn.className = 'pvz-skin-btn pvz-skin-btn-unequip';
					$unequipBtn.textContent = 'Unequip';
					$unequipBtn.addEventListener('click', function () {
						equipSkin(skin.unitType, null, $unequipBtn);
					});
					$actions.appendChild($equippedLabel);
					$actions.appendChild($unequipBtn);
				} else {
					var $equipBtn = document.createElement('button');
					$equipBtn.type = 'button';
					$equipBtn.className = 'pvz-skin-btn pvz-skin-btn-equip';
					$equipBtn.textContent = 'Equip';
					$equipBtn.addEventListener('click', function () {
						equipSkin(skin.unitType, skin.id, $equipBtn);
					});
					$actions.appendChild($equipBtn);
				}

				$card.appendChild($image);
				$card.appendChild($info);
				$card.appendChild($actions);
				$list.appendChild($card);
			});
		}

		function showListError(message) {
			$list.innerHTML = '';
			var $error = document.createElement('div');
			$error.className = 'pvz-skins-error';
			$error.textContent = message;
			$list.appendChild($error);
		}

		function loadSkins() {
			Promise.all([
				authedFetch('/api/skins'),
				authedFetch('/api/player-data').catch(function () {
					return { playerDoc: null };
				})
			])
			.then(function (results) {
				var skinsRes = results[0] || {};
				var playerDoc = results[1] && results[1].playerDoc;
				$gemsCount.textContent = (playerDoc && playerDoc.gems) || 0;
				cachedSkins = skinsRes.skins || [];
				cachedEquippedSkins = skinsRes.equippedSkins || {};
				renderSidebar();
				updateLimitedTab();
				renderCurrentTab();
			})
			.catch(function (err) {
				console.warn('Could not load skins:', err);
				showListError('Could not load skins - are you signed in?');
			});
		}

		function openPurchaseConfirmation(skin, $buyBtn) {
			pendingPurchase = {
				skin: skin,
				button: $buyBtn
			};

			var currentGems = Number($gemsCount.textContent || 0);
			var remaining = currentGems - Number(skin.effectivePrice || 0);
			$confirmText.textContent = 'Buy ' + skin.name + ' for ' + skin.effectivePrice + ' Gems? You will have ' + Math.max(0, remaining) + ' Gems left.';
			$confirmBackdrop.classList.add('pvz-skins-confirm-open');
		}

		function closePurchaseConfirmation() {
			pendingPurchase = null;
			$confirmBackdrop.classList.remove('pvz-skins-confirm-open');
		}

		function confirmPurchase() {
			if (!pendingPurchase) return;

			var pending = pendingPurchase;
			$confirmYes.disabled = true;
			$confirmNo.disabled = true;

			authedFetch('/api/skins/buy', {
				method: 'POST',
				body: JSON.stringify({ skinId: pending.skin.id })
			})
			.then(function () {
				closePurchaseConfirmation();
				loadSkins();
			})
			.catch(function (err) {
				alert(err.message);
				if (pending.button) pending.button.disabled = false;
			})
			.finally(function () {
				$confirmYes.disabled = false;
				$confirmNo.disabled = false;
			});
		}

		function equipSkin(unitType, skinId, $btn) {
			$btn.disabled = true;
			authedFetch('/api/skins/equip', {
				method: 'POST',
				body: JSON.stringify({ unitType: unitType, skinId: skinId })
			})
			.then(function () {
				loadSkins();
			})
			.catch(function (err) {
				alert(err.message);
				$btn.disabled = false;
			});
		}

		function openSkins() {
			// every time the menu opens, start on store
			setTab('store');
			$backdrop.classList.add('pvz-skins-open');
			loadSkins();
		}

		function closeSkins() {
			$backdrop.classList.remove('pvz-skins-open');
			closePurchaseConfirmation();
		}

		$tabs.forEach(function ($tab) {
			$tab.addEventListener('click', function () {
				if (!$tab.disabled) setTab($tab.dataset.tab);
			});
		});

		$confirmYes.addEventListener('click', confirmPurchase);
		$confirmNo.addEventListener('click', closePurchaseConfirmation);

		if ($openBtn) {
			$openBtn.addEventListener('click', openSkins);
		}
		$closeBtn.addEventListener('click', closeSkins);

		$backdrop.addEventListener('click', function (event) {
			if (event.target === $backdrop) {
				closeSkins();
			}
		});

		$confirmBackdrop.addEventListener('click', function (event) {
			if (event.target === $confirmBackdrop) {
				closePurchaseConfirmation();
			}
		});

		$panel.addEventListener('click', function (event) {
			event.stopPropagation();
		});

		// the menu always starts on store
		setTab('store');
	})();
</script>
