<%- include('header', { title: 'Skins' }) %>

<style>
    .pvz-skins-modal {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.55);
        font-family: "Brianne's Hand", sans-serif;
    }

    .pvz-skins-window {
        width: min(940px, 94vw);
        max-height: 90vh;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        background: #78b83f;
        border: 6px solid #4d8727;
        border-radius: 18px;
        box-shadow:
            0 0 0 4px rgba(0, 0, 0, 0.18),
            0 10px 30px rgba(0, 0, 0, 0.45);
        color: white;
    }

    .pvz-skins-header {
        position: relative;
        text-align: center;
        padding: 16px 55px 12px;
    }

    .pvz-skins-title {
        margin: 0;
        font-size: 42px;
        line-height: 1;
        text-shadow: 2px 3px 0 #38631d;
    }

    .pvz-skins-gems {
        margin-top: 8px;
        font-size: 22px;
        color: #ffe35a;
        text-shadow: 1px 2px 0 #4e7421;
    }

    .pvz-skins-close {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 42px;
        height: 42px;
        border: 0;
        border-radius: 11px;
        background: #5d9b2c;
        color: #ff3030;
        font-size: 30px;
        font-weight: bold;
        cursor: pointer;
    }

    .pvz-skins-close:hover {
        background: #6aaa35;
    }

    .pvz-skins-tabs {
        display: flex;
        gap: 4px;
        padding: 0 20px;
    }

    .pvz-skins-tab {
        flex: 1;
        min-height: 55px;
        border: 0;
        border-radius: 8px 8px 0 0;
        background: #528d2d;
        color: white;
        font-family: inherit;
        font-size: 28px;
        cursor: pointer;
        transition: 0.15s;
    }

    .pvz-skins-tab:hover:not(:disabled) {
        background: #619f34;
    }

    .pvz-skins-tab.active {
        background: #3f7722;
        box-shadow: inset 0 -4px 0 #76bf43;
    }

    .pvz-skins-tab:disabled {
        background: #7b8774;
        color: #bfc4bb;
        cursor: not-allowed;
        opacity: 0.65;
    }

    .pvz-skins-content {
        margin: 0 20px 20px;
        padding: 15px;
        overflow-y: auto;
        min-height: 300px;
        background: #3f7024;
        border-radius: 0 0 13px 13px;
    }

    .pvz-skins-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 12px;
    }

    .pvz-skin-card {
        position: relative;
        min-height: 190px;
        padding: 12px;
        background: #4f8b29;
        border: 3px solid #346b1e;
        border-radius: 12px;
        box-shadow: inset 0 2px 0 rgba(255,255,255,0.12);
    }

    .pvz-skin-card.sale {
        border-color: #d4a52c;
        box-shadow:
            inset 0 2px 0 rgba(255,255,255,0.12),
            0 0 0 2px rgba(255, 211, 66, 0.25);
    }

    .pvz-skin-sale-badge {
        position: absolute;
        top: -7px;
        right: -7px;
        padding: 4px 9px;
        border-radius: 7px;
        background: #e64b32;
        color: white;
        font-size: 15px;
        font-weight: bold;
        transform: rotate(4deg);
        box-shadow: 0 2px 0 rgba(0,0,0,0.25);
    }

    .pvz-skin-image {
        width: 82px;
        height: 82px;
        object-fit: contain;
        float: left;
        margin: 0 10px 6px 0;
        background: transparent;
    }

    .pvz-skin-name {
        font-size: 24px;
        font-weight: bold;
        line-height: 1.05;
        margin-top: 2px;
    }

    .pvz-skin-unit {
        margin-top: 4px;
        font-size: 15px;
        line-height: 1.15;
        color: #e9f5d8;
    }

    .pvz-skin-price {
        margin-top: 10px;
        font-size: 20px;
        color: #ffe65b;
    }

    .pvz-skin-old-price {
        margin-right: 6px;
        color: #c7c7c7;
        text-decoration: line-through;
        font-size: 16px;
    }

    .pvz-skin-action {
        clear: both;
        display: block;
        width: 100%;
        margin-top: 12px;
        padding: 8px 12px;
        border: 2px solid #3e8a43;
        border-radius: 8px;
        background: #69c477;
        color: white;
        font-family: inherit;
        font-size: 20px;
        font-weight: bold;
        cursor: pointer;
        text-shadow: 1px 1px 0 rgba(0,0,0,0.25);
    }

    .pvz-skin-action:hover {
        background: #7bd386;
    }

    .pvz-skin-action:disabled {
        background: #7f9680;
        border-color: #697a69;
        color: #cdd2cc;
        cursor: not-allowed;
    }

    .pvz-skins-empty {
        padding: 50px 20px;
        text-align: center;
        color: #dcebcf;
        font-size: 24px;
    }

    .pvz-skins-confirm-overlay {
        position: fixed;
        inset: 0;
        z-index: 10000;
        display: none;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.45);
    }

    .pvz-skins-confirm {
        width: min(560px, 90vw);
        padding: 25px;
        border: 4px solid #4b7f25;
        border-radius: 16px;
        background: #eef4c9;
        color: #31551b;
        text-align: center;
        box-shadow: 0 8px 25px rgba(0,0,0,0.45);
    }

    .pvz-skins-confirm-title {
        font-size: 27px;
        font-weight: bold;
    }

    .pvz-skins-confirm-text {
        margin-top: 8px;
        font-size: 20px;
    }

    .pvz-skins-confirm-buttons {
        display: flex;
        gap: 18px;
        margin-top: 22px;
    }

    .pvz-skins-confirm-buttons button {
        flex: 1;
        padding: 11px;
        border-radius: 8px;
        font-family: inherit;
        font-size: 22px;
        font-weight: bold;
        cursor: pointer;
    }

    .pvz-confirm-yes {
        border: 3px solid #238b32;
        background: #31d44a;
        color: white;
    }

    .pvz-confirm-no {
        border: 3px solid #a9281d;
        background: #e84032;
        color: white;
    }

    @media (max-width: 650px) {
        .pvz-skins-grid {
            grid-template-columns: 1fr;
        }

        .pvz-skins-tab {
            font-size: 21px;
        }

        .pvz-skins-title {
            font-size: 34px;
        }
    }
</style>

<div class="pvz-skins-modal" id="skinsModal">
    <div class="pvz-skins-window">

        <div class="pvz-skins-header">
            <button class="pvz-skins-close" id="skinsClose">×</button>

            <h1 class="pvz-skins-title">Skins</h1>

            <div class="pvz-skins-gems">
                💎 <span id="skinsGemCount">0</span> Gems
            </div>
        </div>

        <div class="pvz-skins-tabs">
            <button class="pvz-skins-tab active" data-tab="store">
                Store
            </button>

            <button class="pvz-skins-tab" data-tab="inventory">
                Inventory
            </button>

            <button class="pvz-skins-tab" data-tab="limited">
                Limited
            </button>
        </div>

        <div class="pvz-skins-content">
            <div class="pvz-skins-grid" id="skinsGrid"></div>
        </div>
    </div>
</div>

<div class="pvz-skins-confirm-overlay" id="skinsConfirmOverlay">
    <div class="pvz-skins-confirm">

        <div class="pvz-skins-confirm-title">
            Are you sure you want to purchase <span id="confirmSkinName">(skin)</span>?
        </div>

        <div class="pvz-skins-confirm-text">
            You will have
            <span id="confirmRemainingGems">0</span>
            💎 gems left after you purchase this skin, so think about it!
        </div>

        <div class="pvz-skins-confirm-buttons">
            <button class="pvz-confirm-yes" id="confirmSkinPurchase">
                Let's rock!
            </button>

            <button class="pvz-confirm-no" id="cancelSkinPurchase">
                Maybe later!
            </button>
        </div>
    </div>
</div>

<script>
(function () {
    var currentTab = 'store';
    var cachedSkins = [];
    var pendingSkin = null;

    var modal = document.getElementById('skinsModal');
    var grid = document.getElementById('skinsGrid');
    var gemCount = document.getElementById('skinsGemCount');

    var confirmOverlay =
        document.getElementById('skinsConfirmOverlay');

    var confirmName =
        document.getElementById('confirmSkinName');

    var confirmRemaining =
        document.getElementById('confirmRemainingGems');

    function escapeHtml(value) {
        return String(value == null ? '' : value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function getCurrentGems() {
        var element =
            document.querySelector('[data-gems], #gems, .gems');

        if (!element) {
            return 0;
        }

        var match = String(element.textContent || '')
            .replace(/,/g, '')
            .match(/\d+/);

        return match ? Number(match[0]) : 0;
    }

    function setGemDisplay(value) {
        if (gemCount) {
            gemCount.textContent = Number(value || 0).toLocaleString();
        }
    }

    function setActiveTab(tab) {
        currentTab = tab;

        document.querySelectorAll('.pvz-skins-tab')
            .forEach(function (button) {
                button.classList.toggle(
                    'active',
                    button.dataset.tab === tab
                );
            });

        renderCurrentTab();
    }

    function updateLimitedTabState() {
        var limitedSkins = cachedSkins.filter(function (skin) {
            return skin.availability === 'limited' &&
                   skin.purchasable;
        });

        var limitedTab =
            document.querySelector(
                '.pvz-skins-tab[data-tab="limited"]'
            );

        limitedTab.disabled = limitedSkins.length === 0;

        if (limitedTab.disabled && currentTab === 'limited') {
            setActiveTab('store');
        }
    }

    function renderCurrentTab() {
        var skins = cachedSkins.slice();

        if (currentTab === 'inventory') {
            skins = skins.filter(function (skin) {
                return skin.owned;
            });
        } else if (currentTab === 'limited') {
            skins = skins.filter(function (skin) {
                return skin.availability === 'limited' &&
                       skin.purchasable;
            });
        } else {
            skins.sort(function (a, b) {
                return Number(!!b.onSale) -
                       Number(!!a.onSale);
            });
        }

        if (!skins.length) {
            grid.innerHTML =
                '<div class="pvz-skins-empty">' +
                'There are no skins here right now.' +
                '</div>';

            return;
        }

        grid.innerHTML = skins.map(function (skin) {
            var price = Number(
                skin.effectivePrice != null
                    ? skin.effectivePrice
                    : skin.price
            );

            var oldPrice =
                Number(skin.price) > price
                    ? Number(skin.price)
                    : null;

            var saleBadge =
                skin.onSale
                    ? '<div class="pvz-skin-sale-badge">SALE!</div>'
                    : '';

            var actionText =
                skin.owned ? 'Equip' : 'Buy';

            var disabled =
                skin.owned
                    ? ''
                    : (!skin.purchasable ? 'disabled' : '');

            return (
                '<div class="pvz-skin-card ' +
                    (skin.onSale ? 'sale' : '') +
                '">' +

                    saleBadge +

                    '<img class="pvz-skin-image" ' +
                        'src="' + escapeHtml(skin.image) + '" ' +
                        'alt="' + escapeHtml(skin.name) + '">' +

                    '<div class="pvz-skin-name">' +
                        escapeHtml(skin.name) +
                    '</div>' +

                    '<div class="pvz-skin-unit">' +
                        escapeHtml(skin.unitTypeName) +
                    '</div>' +

                    '<div class="pvz-skin-price">' +

                        (oldPrice !== null
                            ? '<span class="pvz-skin-old-price">' +
                                oldPrice +
                              '</span>'
                            : '') +

                        '💎 ' + price +

                    '</div>' +

                    '<button class="pvz-skin-action" ' +
                        'data-skin-id="' +
                        escapeHtml(skin.id) + '" ' +
                        disabled +
                    '>' +
                        actionText +
                    '</button>' +

                '</div>'
            );
        }).join('');
    }

    function openPurchaseConfirmation(skin) {
        var gems = getCurrentGems();
        var price = Number(
            skin.effectivePrice != null
                ? skin.effectivePrice
                : skin.price
        );

        pendingSkin = skin;

        confirmName.textContent = skin.name;
        confirmRemaining.textContent =
            Math.max(0, gems - price).toLocaleString();

        confirmOverlay.style.display = 'flex';
    }

    function closePurchaseConfirmation() {
        pendingSkin = null;
        confirmOverlay.style.display = 'none';
    }

    async function purchaseSkin(skin) {
        var response = await fetch('/api/skins/purchase', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                skinId: skin.id
            })
        });

        var result = await response.json();

        if (!response.ok) {
            throw new Error(
                result.error || 'Unable to purchase skin.'
            );
        }

        return result;
    }

    async function loadSkins() {
        try {
            var response = await fetch('/api/skins');

            if (!response.ok) {
                throw new Error('Unable to load skins.');
            }

            var data = await response.json();

            cachedSkins = data.skins || [];

            setGemDisplay(getCurrentGems());
            updateLimitedTabState();

            renderCurrentTab();
        } catch (error) {
            grid.innerHTML =
                '<div class="pvz-skins-empty">' +
                'Unable to load skins right now.' +
                '</div>';

            console.error(error);
        }
    }

    document.querySelectorAll('.pvz-skins-tab')
        .forEach(function (button) {
            button.addEventListener('click', function () {
                if (button.disabled) {
                    return;
                }

                setActiveTab(button.dataset.tab);
            });
        });

    grid.addEventListener('click', async function (event) {
        var button =
            event.target.closest('.pvz-skin-action');

        if (!button || button.disabled) {
            return;
        }

        var skin = cachedSkins.find(function (item) {
            return item.id === button.dataset.skinId;
        });

        if (!skin) {
            return;
        }

        if (skin.owned) {
            return;
        }

        openPurchaseConfirmation(skin);
    });

    document.getElementById('confirmSkinPurchase')
        .addEventListener('click', async function () {
            if (!pendingSkin) {
                return;
            }

            var skin = pendingSkin;

            try {
                this.disabled = true;

                await purchaseSkin(skin);

                closePurchaseConfirmation();

                await loadSkins();
            } catch (error) {
                alert(error.message);
            } finally {
                this.disabled = false;
            }
        });

    document.getElementById('cancelSkinPurchase')
        .addEventListener(
            'click',
            closePurchaseConfirmation
        );

    document.getElementById('skinsClose')
        .addEventListener('click', function () {
            modal.style.display = 'none';
        });

    // Always open on Store.
    currentTab = 'store';
    setActiveTab('store');
    loadSkins();
})();
</script>
